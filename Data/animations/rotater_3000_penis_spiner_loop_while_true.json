{
    "idle": {
        "duration": 60,
        "anchor": "center",
        "keyframes": {
            "0": {
                "offset_x": 0.0,
                "offset_y": 0.0,
                "scale_x": 1.0,
                "scale_y": 1.0,
                "rotation": 0.0,
                "ease": "easeInQuad"
            },
            "30": {
                "offset_x": 0.0,
                "offset_y": 0.0,
                "scale_x": 0.8,
                "scale_y": 1.3,
                "rotation": 180.0,
                "ease": "easeOutQuad"
            },
            "60": {
                "offset_x": 0.0,
                "offset_y": 0.0,
                "scale_x": 1.0,
                "scale_y": 1.0,
                "rotation": 360.0,
                "ease": "easeInQuad"
            }
        }
    }
}